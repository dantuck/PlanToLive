---
import Legal from '../layouts/Legal.astro';
import { CONTACT_EMAIL, SITE_NAME, SITE_SHORT, appNames } from '../site';

const names = await appNames();
---

<Legal title="Terms of Use">
  <p>
    These terms govern your use of the {SITE_NAME} website. Our apps, including {names}, may be subject to their own terms, which apply when you use those apps.
  </p>

  <h2>Use of the site</h2>
  <p>
    You may browse this site for lawful purposes. Please don't attempt to disrupt it, probe it for
    vulnerabilities without permission, or use it to harm others.
  </p>

  <h2>Intellectual property</h2>
  <p>
    The content, names, logos, and design of this site belong to {SITE_NAME} or its licensors.
    You may not copy or reuse them without permission, except as allowed by law.
  </p>

  <h2>No warranty</h2>
  <p>
    The site is provided "as is" without warranties of any kind. We try to keep information accurate
    but don't guarantee it is complete or current.
  </p>

  <h2>Limitation of liability</h2>
  <p>
    To the extent permitted by law, {SITE_NAME} is not liable for any indirect or consequential
    damages arising from your use of this site.
  </p>

  <h2>Changes</h2>
  <p>We may update these terms from time to time. The date above shows the latest revision.</p>

  <h2>Contact</h2>
  <p>
    {SITE_NAME} · <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </p>
</Legal>
