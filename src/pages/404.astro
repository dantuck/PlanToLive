---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Plan To Live">
  <main id="main" class="wrap lost">
    <p class="eyebrow">404</p>
    <h1>That page isn't here.</h1>
    <p class="lede">The link may be old or mistyped. The apps are all on the home page.</p>
    <p><a class="btn btn-primary" href="/">Back to home</a></p>
  </main>
</Base>

<style>
  .lost {
    padding-top: clamp(4rem, 12vw, 8rem);
    text-align: center;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
  }
  .lede {
    margin: 1rem auto 0;
    max-width: 30rem;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .lost p:last-child {
    margin-top: 2rem;
  }
</style>
