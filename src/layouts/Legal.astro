---
import Base from './Base.astro';
import { LEGAL_UPDATED, SITE_SHORT } from '../site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} · ${SITE_SHORT}`}>
  <main id="main" class="legal">
    <h1>{title}</h1>
    <p class="updated">Last updated {LEGAL_UPDATED}</p>
    <slot />
  </main>
</Base>

<style>
  .legal {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem var(--gutter) 0;
  }
  h1 {
    font-size: 2rem;
  }
  .updated {
    margin-bottom: 2rem;
    color: var(--muted);
  }
  .legal :global(h2) {
    margin: 2.25rem 0 0.5rem;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  .legal :global(p),
  .legal :global(li) {
    margin-top: 0.75rem;
  }
  .legal :global(a) {
    color: var(--ink);
  }
</style>
