---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { CONTACT_EMAIL, SITE_NAME, SITE_SHORT } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_SHORT,
  description = 'Small, focused apps for a well-planned life.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_SHORT} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Theme: applied before first paint; the header buttons are wired up by event delegation.
      (function () {
        var KEY = 'theme';
        var root = document.documentElement;
        function saved() {
          try {
            var t = localStorage.getItem(KEY);
            return t === 'light' || t === 'dark' ? t : null;
          } catch (e) {
            return null;
          }
        }
        function render() {
          var t = saved();
          if (t) root.dataset.theme = t;
          else delete root.dataset.theme;
          document.querySelectorAll('[data-theme-choice]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.themeChoice === (t || 'system')));
          });
        }
        render();
        document.addEventListener('DOMContentLoaded', render);
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-theme-choice]');
          if (!b) return;
          try {
            if (b.dataset.themeChoice === 'system') localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, b.dataset.themeChoice);
          } catch (err) {}
          render();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap bar">
        <a href="/" class="brand">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>{SITE_SHORT}</span>
        </a>
        <nav aria-label="Main">
          <a class="link" href="/#apps">Apps</a>
          <a class="link" href="/#about">About</a>
          <a class="btn btn-primary cta" href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <slot />
    <footer class="wrap site-foot">
      <span>© {new Date().getFullYear()} {SITE_NAME}</span>
      <span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
    </footer>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 95%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .brand img {
    border-radius: 8px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .link {
    color: var(--muted);
    text-decoration: none;
  }
  .link:hover {
    color: var(--ink);
  }
  .cta {
    padding: 0.45rem 1.1rem;
    font-size: 0.95rem;
  }
  @media (max-width: 32.5rem) {
    .link {
      display: none;
    }
    nav {
      gap: 0.75rem;
    }
  }
  .site-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .site-foot a {
    text-decoration: none;
  }
  .site-foot a:hover {
    color: var(--ink);
  }
</style>
