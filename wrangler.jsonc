{
  "name": "plantolive-www",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "plantolive.app", "custom_domain": true },
    { "pattern": "www.plantolive.app", "custom_domain": true }
  ]
}
